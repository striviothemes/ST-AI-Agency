---
import type { Customer } from '../types';
import { url } from '../utils/url';

interface Props {
  customer: Customer;
  delay?: number;
}

const { customer, delay = 0 } = Astro.props;
---

<article class="wcard rv" style={delay ? `--d:${delay}ms` : undefined}>
  <div class="wcard__i">
    <img src={url(customer.image)} alt={customer.imageAlt} width="900" height="620" loading="lazy" decoding="async" />
    <span class="wcard__pill">{customer.sector}</span>
  </div>
  <div class="wcard__b">
    <h3 class="d4">{customer.url ? <a href={url(customer.url)}>{customer.title}</a> : customer.title}</h3>
    <p>{customer.description}</p>
    <dl class="wcard__m">
      {customer.metrics.map((m) => (
        <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
      ))}
    </dl>
  </div>
</article>
