---
import { siteConfig } from '../config/site';
import { absoluteUrl, url } from '../utils/url';

export interface SEOProps {
  /** Page title without the site name. Omit on the homepage. */
  title?: string;
  description?: string;
  /** Image path in /public (e.g. "/images/blog-ai-agents.webp") or an absolute URL. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  /** ISO dates for articles. */
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  /** JSON-LD objects to print for this page. */
  schema?: Record<string, unknown>[];
}

type Props = SEOProps;

const {
  title,
  description = siteConfig.description,
  image = siteConfig.seo.ogImage,
  imageAlt = siteConfig.seo.ogImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  noindex = false,
  schema = [],
} = Astro.props;

const fullTitle = title ? `${title}${siteConfig.seo.titleSeparator}${siteConfig.name}` : siteConfig.seo.defaultTitle;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = /^https?:\/\//.test(image) ? image : absoluteUrl(image, Astro.site);
const homeUrl = absoluteUrl('/', Astro.site);

const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${homeUrl}#organization`,
    name: siteConfig.name,
    url: homeUrl,
    logo: absoluteUrl('/favicon.svg', Astro.site),
    email: siteConfig.email,
    sameAs: siteConfig.social.filter((s) => /^https?:\/\//.test(s.href)).map((s) => s.href),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${homeUrl}#website`,
    name: siteConfig.name,
    url: homeUrl,
    description: siteConfig.description,
    inLanguage: siteConfig.lang,
    publisher: { '@id': `${homeUrl}#organization` },
  },
];
const jsonLd = [...siteSchema, ...schema];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{!noindex && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content={siteConfig.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{type === 'article' && author && <meta property="article:author" content={author} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />
{siteConfig.seo.twitterHandle && <meta name="twitter:site" content={siteConfig.seo.twitterHandle} />}

<meta name="theme-color" content={siteConfig.seo.themeColor} />
<link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} — Insights`} href={url('/rss.xml')} />
<link rel="sitemap" href={url('/sitemap-index.xml')} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
