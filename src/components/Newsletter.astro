---
import { siteConfig } from '../config/site';
import { newsletter } from '../data/home';

const { newsletterAction, netlify } = siteConfig.forms;
---

<div class="nlt">
  <div>
    <h2 class="d3">{newsletter.title}</h2>
    <p class="copy">{newsletter.description}</p>
  </div>
  <form
    class="js-form"
    action={newsletterAction || undefined}
    method="post"
    name="newsletter"
    data-demo={newsletterAction || netlify ? undefined : 'true'}
    data-netlify={netlify ? 'true' : undefined}
  >
    {netlify && <input type="hidden" name="form-name" value="newsletter" />}
    <div class="nlt__f">
      <label for="nl-email" class="sr-only">Email address</label>
      <input id="nl-email" name="email" type="email" placeholder="you@company.com" autocomplete="email" required />
      <button class="btn btn--heat" type="submit">{newsletter.submitLabel}</button>
    </div>
    <p class="form__status" role="status" aria-live="polite"></p>
  </form>
</div>
