---
import SectionHeading from './SectionHeading.astro';
import PostCard from './PostCard.astro';
import Button from './Button.astro';
import { sections } from '../data/home';
import { getPosts } from '../utils/blog';

interface Props {
  limit?: number;
}

const { limit = 3 } = Astro.props;
const posts = (await getPosts()).slice(0, limit);
---

{posts.length > 0 && (
  <section class="sec on-white" id="insights" aria-labelledby="insights-title">
    <div class="wrap">
      <SectionHeading heading={sections.insights} id="insights-title" />
      <div class="posts">
        {posts.map((post, i) => <PostCard post={post} delay={i * 80} />)}
      </div>
      <div class="insights__more rv">
        <Button href="/blog" variant="oink">All insights</Button>
      </div>
    </div>
  </section>
)}
