---
import Button from './Button.astro';
import FrameLines from './FrameLines.astro';
import { siteConfig } from '../config/site';
import { finalCta } from '../data/home';

interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
}

const { kicker = finalCta.kicker, title = finalCta.title, lead = finalCta.lead } = Astro.props;
---

<section class="cta on-heat" aria-labelledby="cta-title">
  <FrameLines plus={{ top: 52, bottom: 52 }} />
  <div class="wrap wrap--front">
    <span class="kicker kicker--w rv">{kicker}</span>
    <h2 class="d2 rv" style="--d:60ms" id="cta-title">{title}</h2>
    <p class="lead muted rv" style="--d:120ms">{lead}</p>
    <div class="btns rv" style="--d:180ms">
      <Button href={siteConfig.cta.href} variant="white">{siteConfig.cta.label}</Button>
      <Button href={`mailto:${siteConfig.email}`} variant="ow">{siteConfig.email}</Button>
    </div>
  </div>
</section>
