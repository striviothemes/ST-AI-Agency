---
import Button from './Button.astro';
import Icon from './icons/Icon.astro';
import type { PricingPlan } from '../types';

interface Props {
  plan: PricingPlan;
  delay?: number;
}

const { plan, delay = 0 } = Astro.props;
---

<article class:list={['plan', 'rv', { 'plan--hot': plan.highlighted }]} style={delay ? `--d:${delay}ms` : undefined}>
  {plan.badge && <span class="plan__tag">{plan.badge}</span>}
  <h3 class="plan__n">{plan.name}</h3>
  <p class="plan__pr">{plan.price}{plan.billing && <> <em>{plan.billing}</em></>}</p>
  <p class="plan__d">{plan.description}</p>
  <ul>
    {plan.features.map((f) => <li><Icon name="check" />{f}</li>)}
  </ul>
  <Button href={plan.cta.href} variant={plan.highlighted ? 'white' : 'oink'}>{plan.cta.label}</Button>
</article>
