---
/** Decorative hairline frame with optional "+" corner marks, as in the original design. */
interface Props {
  /** Offsets of the corner marks from the top and bottom, in px. Omit to hide the marks. */
  plus?: { top: number; bottom: number };
}

const { plus } = Astro.props;
---

<div class="wrap frame-wrap" aria-hidden="true">
  <div class="frame">
    <i></i><i></i>
    {plus && (
      <>
        <span class="plus" style={`left:-7px;top:${plus.top}px`}></span>
        <span class="plus" style={`right:-7px;top:${plus.top}px`}></span>
        <span class="plus" style={`left:-7px;bottom:${plus.bottom}px`}></span>
        <span class="plus" style={`right:-7px;bottom:${plus.bottom}px`}></span>
      </>
    )}
  </div>
</div>
