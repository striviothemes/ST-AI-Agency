---
import Icon from './icons/Icon.astro';
import { siteConfig } from '../config/site';
import { sections, contactForm } from '../data/home';
import { phoneDisplay } from '../utils/url';

const h = sections.contact;
const { contactAction, netlify } = siteConfig.forms;
---

<section class="sec on-white" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="ctc">
      <div>
        <span class="kicker kicker--heat rv">{h.kicker}</span>
        <h2 class="d2 rv" style="--d:60ms" id="contact-title" set:html={h.title} />
        <p class="lead muted rv" style="--d:120ms">{h.lead}</p>

        <ul class="rv" style="--d:180ms">
          <li class="ci">
            <span class="ci__i" aria-hidden="true"><Icon name="mail" /></span>
            <div><b>Email</b><p><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p></div>
          </li>
          <li class="ci">
            <span class="ci__i" aria-hidden="true"><Icon name="phone" /></span>
            <div><b>Call</b><p><a href={`tel:${siteConfig.phoneHref}`}>{phoneDisplay(siteConfig.phone)}</a></p></div>
          </li>
          <li class="ci">
            <span class="ci__i" aria-hidden="true"><Icon name="pin" /></span>
            <div><b>{siteConfig.location.label}</b><p>{siteConfig.location.lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}</p></div>
          </li>
          <li class="ci">
            <span class="ci__i" aria-hidden="true"><Icon name="time" /></span>
            <div><b>Response time</b><p>{siteConfig.responseTime}</p></div>
          </li>
        </ul>
      </div>

      <form
        class="form js-form rv"
        style="--d:120ms"
        action={contactAction || undefined}
        method="post"
        name="contact"
        aria-labelledby="contact-title"
        data-demo={contactAction || netlify ? undefined : 'true'}
        data-netlify={netlify ? 'true' : undefined}
        netlify-honeypot={netlify ? 'company_website' : undefined}
      >
        {netlify && <input type="hidden" name="form-name" value="contact" />}
        <p class="hp" aria-hidden="true">
          <label>Leave this field empty <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="fg">
          <div class="f"><label for="fn">Full name</label><input id="fn" name="name" type="text" placeholder="Priya Raghavan" autocomplete="name" required /></div>
          <div class="f"><label for="fc">Company</label><input id="fc" name="company" type="text" placeholder="Northwind Freight" autocomplete="organization" /></div>
          <div class="f"><label for="fe">Work email</label><input id="fe" name="email" type="email" placeholder="you@company.com" autocomplete="email" required /></div>
          <div class="f"><label for="fp">Phone</label><input id="fp" name="phone" type="tel" placeholder="+1 (000) 123-456" autocomplete="tel" /></div>
          <div class="f f--w"><label for="fw">Which workflow hurts most?</label>
            <select id="fw" name="workflow">
              {contactForm.workflows.map((w) => <option>{w}</option>)}
            </select>
          </div>
          <div class="f f--w"><label for="fm">Tell us about the work</label>
            <textarea id="fm" name="message" placeholder="How many people touch it today, how many items per week, and what a wrong answer costs you."></textarea>
          </div>
        </div>
        <button class="btn btn--heat" type="submit">{contactForm.submitLabel} <Icon name="arrow-right" /></button>
        <p class="form__n">{contactForm.note}</p>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>
