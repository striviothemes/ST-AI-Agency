---
import SectionHeading from './SectionHeading.astro';
import PricingCard from './PricingCard.astro';
import { pricingPlans } from '../data/pricing';
import { sections } from '../data/home';
---

<section class="sec on-cream" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <SectionHeading heading={sections.pricing} id="pricing-title" />
    <div class="plans">
      {pricingPlans.map((plan, i) => <PricingCard plan={plan} delay={i * 80} />)}
    </div>
  </div>
</section>
