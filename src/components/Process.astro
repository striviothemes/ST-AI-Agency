---
import SectionHeading from './SectionHeading.astro';
import FrameLines from './FrameLines.astro';
import { processSteps } from '../data/process';
import { sections } from '../data/home';
---

<section class="sec on-heat" id="process" aria-labelledby="process-title">
  <FrameLines />
  <div class="wrap wrap--front">
    <SectionHeading heading={sections.process} tone="w" id="process-title" />
    <ol class="steps">
      {processSteps.map((step, i) => (
        <li class="stp rv" style={i ? `--d:${i * 90}ms` : undefined}>
          <span class="stp__n" aria-hidden="true">{step.number}</span>
          <h3 class="d4"><span class="sr-only">Step {step.number}: </span>{step.title}</h3>
          <p>{step.description}</p>
          <div class="stp__wk">{step.timing}</div>
        </li>
      ))}
    </ol>
  </div>
</section>
