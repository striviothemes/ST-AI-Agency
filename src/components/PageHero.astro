---
import FrameLines from './FrameLines.astro';
import { url } from '../utils/url';
import type { Link } from '../types';

interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  breadcrumbs?: Link[];
  center?: boolean;
  /** Heading scale: d1 for landing-style heroes, d2 for long titles such as blog posts. */
  size?: 'd1' | 'd2';
  class?: string;
}

const { kicker, title, lead, breadcrumbs, center = false, size = 'd1', class: className } = Astro.props;
---

<section class:list={['phero', 'on-heat', { 'phero--center': center }, className]} data-hero aria-labelledby="page-title">
  <div class="hero__grain" aria-hidden="true"></div>
  <FrameLines plus={{ top: 124, bottom: 40 }} />
  <div class="wrap wrap--front">
    <div class="phero__in">
      {breadcrumbs && breadcrumbs.length > 0 && (
        <nav class="crumbs rv" aria-label="Breadcrumb">
          <ol>
            {breadcrumbs.map((c, i) =>
              i === breadcrumbs.length - 1 ? (
                <li><span aria-current="page">{c.label}</span></li>
              ) : (
                <li><a href={url(c.href)}>{c.label}</a></li>
              ),
            )}
          </ol>
        </nav>
      )}
      <slot name="before" />
      {kicker && <span class="kicker kicker--w rv" style="--d:40ms">{kicker}</span>}
      <h1 class={`${size} rv`} style="--d:70ms" id="page-title">{title}</h1>
      {lead && <p class="lead rv" style="--d:130ms">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
