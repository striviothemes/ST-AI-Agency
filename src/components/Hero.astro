---
import Button from './Button.astro';
import FrameLines from './FrameLines.astro';
import Icon from './icons/Icon.astro';
import { hero, heroStats } from '../data/home';
import { url } from '../utils/url';
---

<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__media" aria-hidden="true">
    <img src={url(hero.image)} alt="" width="1200" height="800" fetchpriority="high" decoding="async" />
  </div>
  <div class="hero__duo" aria-hidden="true"></div>
  <div class="hero__warm" aria-hidden="true"></div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__grain" aria-hidden="true"></div>

  <FrameLines plus={{ top: 124, bottom: 150 }} />

  <div class="hero__in">
    <div class="wrap">
      <div class="hero__copy">
        <div class="hero__eyebrow rv">
          <span class="pip" aria-hidden="true"></span>
          <span class="kicker kicker--w">{hero.eyebrow}</span>
        </div>
        <h1 class="d1 rv" style="--d:70ms" id="hero-title">
          {hero.headline.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line.tint ? <span class="tint">{line.text}</span> : line.text}
            </>
          ))}
        </h1>
        <p class="lead hero__lead rv" style="--d:130ms">{hero.lead}</p>
        <div class="btns rv" style="--d:190ms">
          <Button href={hero.primaryCta.href} variant="white">{hero.primaryCta.label}</Button>
          <Button href={hero.secondaryCta.href} variant="ow">{hero.secondaryCta.label}</Button>
        </div>
        <ul class="hero__cred rv" style="--d:250ms">
          {hero.credentials.map((c) => (
            <li><Icon name={c.icon} />{c.label}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="hero__base">
    <dl class="wrap">
      {heroStats.map((s) => (
        <div class="hb"><dt>{s.value}</dt><dd>{s.label}</dd></div>
      ))}
    </dl>
  </div>
</section>
