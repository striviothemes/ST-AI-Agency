---
import type { SectionHeading } from '../types';

interface Props {
  heading: SectionHeading;
  /** Kicker color variant. */
  tone?: 'heat' | 'w' | 'o4';
  id?: string;
}

const { heading, tone = 'heat', id } = Astro.props;
---

<div class="shead">
  <div>
    <span class={`kicker kicker--${tone} rv`}>{heading.kicker}</span>
    <h2 class="d2 rv" style="--d:60ms" id={id} set:html={heading.title} />
  </div>
  {heading.lead && <p class="lead muted shead__r rv" style="--d:120ms">{heading.lead}</p>}
</div>
