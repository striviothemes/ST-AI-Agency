---
import Icon from './icons/Icon.astro';
import type { Solution } from '../types';
import { url } from '../utils/url';

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
---

<li>
  <a class="srow rv" href={url(solution.href)}>
    <span class="srow__n" aria-hidden="true">{solution.number}</span>
    <h3 class="d3">{solution.title}</h3>
    <p>{solution.description}</p>
    <span class="srow__go" aria-hidden="true"><Icon name="arrow-up-right" /></span>
    {solution.image && (
      <span class="srow__peek" aria-hidden="true">
        <img src={url(solution.image)} alt="" width="500" height="360" loading="lazy" decoding="async" />
      </span>
    )}
  </a>
</li>
