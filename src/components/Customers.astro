---
import SectionHeading from './SectionHeading.astro';
import CustomerCard from './CustomerCard.astro';
import { customers } from '../data/customers';
import { sections } from '../data/home';
---

<section class="sec on-ink" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <SectionHeading heading={sections.work} tone="o4" id="work-title" />
    <div class="work">
      {customers.map((customer, i) => <CustomerCard customer={customer} delay={i * 80} />)}
    </div>
  </div>
</section>
