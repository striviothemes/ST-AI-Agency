---
import FeatureList from './FeatureList.astro';
import { sections, platformImage } from '../data/home';
import { url } from '../utils/url';

const h = sections.platform;
---

<section class="sec on-white" id="platform" aria-labelledby="platform-title">
  <div class="wrap">
    <div class="split">
      <div>
        <span class="kicker kicker--heat rv">{h.kicker}</span>
        <h2 class="d2 rv" style="--d:60ms" id="platform-title" set:html={h.title} />
        <p class="lead muted rv" style="--d:120ms">{h.lead}</p>
        <FeatureList />
      </div>

      <div class="split__img rv" style="--d:100ms">
        <img src={url(platformImage.src)} alt={platformImage.alt} width="696" height="800" loading="lazy" decoding="async" />
        <span class="split__tag">{platformImage.tag}</span>
      </div>
    </div>
  </div>
</section>
