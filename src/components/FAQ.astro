---
import Button from './Button.astro';
import Icon from './icons/Icon.astro';
import { faqs } from '../data/faq';
import { sections } from '../data/home';

const h = sections.faq;
---

<section class="sec on-cream" id="faq" aria-labelledby="faq-title">
  <div class="wrap">
    <div class="faq">
      <div>
        <span class="kicker kicker--heat rv">{h.kicker}</span>
        <h2 class="d2 rv" style="--d:60ms" id="faq-title" set:html={h.title} />
        <p class="lead muted rv" style="--d:120ms">{h.lead}</p>
        <Button href="/#contact" variant="oink" class="rv" style="--d:180ms">Ask us directly</Button>
      </div>

      <div class="acc rv" style="--d:80ms" data-accordion>
        {faqs.map((item, i) => (
          <div class:list={['qa', { on: i === 0 }]}>
            <h3>
              <button class="qa__q" type="button" id={`faq-q-${i}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`faq-a-${i}`}>
                <b>{item.question}</b>
                <span class="qa__ic" aria-hidden="true"><Icon name="plus" /></span>
              </button>
            </h3>
            <div class="qa__a" id={`faq-a-${i}`}>
              <p>{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Single-open accordion. Without JavaScript every answer is simply visible.
  document.querySelectorAll<HTMLElement>('[data-accordion]').forEach((acc) => {
    const items = Array.from(acc.querySelectorAll<HTMLElement>('.qa'));
    const panel = (qa: HTMLElement) => qa.querySelector<HTMLElement>('.qa__a')!;
    const button = (qa: HTMLElement) => qa.querySelector<HTMLButtonElement>('.qa__q')!;

    const set = (qa: HTMLElement, open: boolean) => {
      qa.classList.toggle('on', open);
      button(qa).setAttribute('aria-expanded', String(open));
      panel(qa).style.maxHeight = open ? `${panel(qa).scrollHeight}px` : '';
    };

    items.forEach((qa) => {
      if (qa.classList.contains('on')) set(qa, true);
      button(qa).addEventListener('click', () => {
        const willOpen = !qa.classList.contains('on');
        items.forEach((other) => set(other, false));
        if (willOpen) set(qa, true);
      });
    });

    // keep the open panel's height correct when text reflows
    window.addEventListener('resize', () => items.filter((qa) => qa.classList.contains('on')).forEach((qa) => set(qa, true)));
  });
</script>
