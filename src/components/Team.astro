---
import SectionHeading from './SectionHeading.astro';
import Icon from './icons/Icon.astro';
import { team } from '../data/team';
import { sections } from '../data/home';
import { url } from '../utils/url';
---

<section class="sec on-white" id="team" aria-labelledby="team-title">
  <div class="wrap">
    <SectionHeading heading={sections.team} id="team-title" />
    <div class="team">
      {team.map((m, i) => (
        <article class="mem rv" style={i ? `--d:${i * 70}ms` : undefined}>
          <div class="mem__p">
            <img src={url(m.image)} alt={m.imageAlt ?? `Portrait of ${m.name}`} width="600" height="780" loading="lazy" decoding="async" />
          </div>
          <h3>{m.name}</h3>
          <p>{m.role}</p>
          {m.bio && <p>{m.bio}</p>}
          {m.social && m.social.length > 0 && (
            <ul class="soc">
              {m.social.map((s) => (
                <li><a href={s.href} aria-label={`${m.name} on ${s.label}`} rel="noopener"><Icon name={s.icon} /></a></li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
