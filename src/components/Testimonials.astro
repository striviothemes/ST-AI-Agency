---
import Icon from './icons/Icon.astro';
import { testimonials } from '../data/testimonials';
import { sections } from '../data/home';
import { url } from '../utils/url';

const t = testimonials[0];
---

{t && (
  <section class="sec on-cream" aria-labelledby="testimonial-title">
    <div class="wrap">
      <div class="quote">
        {t.image && (
          <div class="quote__p rv">
            <img src={url(t.image)} alt={t.imageAlt ?? ''} width="602" height="800" loading="lazy" decoding="async" />
          </div>
        )}
        <figure>
          <h2 class="kicker kicker--heat rv" id="testimonial-title">{sections.testimonial.kicker}</h2>
          <blockquote class="rv" style="--d:70ms"><p>{t.quote}</p></blockquote>
          <figcaption class="quote__by rv" style="--d:140ms">
            <b>{t.name}</b>
            <span>{t.role}, {t.company}</span>
            {t.link && (
              <a href={url(t.link.href)} class="arrow arrow--heat">
                <span>{t.link.label}</span><Icon name="arrow-right" />
              </a>
            )}
          </figcaption>
        </figure>
      </div>
    </div>
  </section>
)}
