---
import { url } from '../utils/url';

interface Props {
  href: string;
  variant?: 'white' | 'ow' | 'heat' | 'oink' | 'ink';
  size?: 'sm';
  class?: string;
  style?: string;
}

const { href, variant = 'heat', size, class: className, style } = Astro.props;
---

<a href={url(href)} class:list={['btn', `btn--${variant}`, size && `btn--${size}`, className]} style={style}><slot /></a>
