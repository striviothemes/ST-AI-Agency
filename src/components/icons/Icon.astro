---
import { icons, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Accessible name. Omit for decorative icons (the default). */
  label?: string;
}

const { name, size, class: className, label } = Astro.props;
const icon = icons[name];
const px = size ?? icon.size;
---

<svg
  class={className}
  width={px}
  height={px}
  viewBox={icon.viewBox}
  fill="none"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icon.body}
/>
