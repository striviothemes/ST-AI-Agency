---
/**
 * ST AI Agency monogram, exactly as drawn in the original design.
 * `light`  — white mark for dark/orange backgrounds (header).
 * `footer` — cream frame with an orange mark for the dark footer.
 */
interface Props {
  variant?: 'light' | 'footer';
}

const { variant = 'light' } = Astro.props;
const c =
  variant === 'footer'
    ? { frame: '#FFF6EC', frameOpacity: '.5', mark: '#FF8A3D', dot: '#1C0F07', dotStroke: '#FF8A3D' }
    : { frame: '#fff', frameOpacity: '.65', mark: '#fff', dot: '#EC5A11', dotStroke: '#fff' };
---

<svg viewBox="0 0 36 36" fill="none" aria-hidden="true" focusable="false">
  <rect x=".9" y=".9" width="34.2" height="34.2" rx="10" stroke={c.frame} stroke-width="1.4" opacity={c.frameOpacity}></rect>
  <path d="M18 8.4 27.6 27.6h-5.1L18 18.6l-4.5 9H8.4L18 8.4Z" fill={c.mark}></path>
  <circle cx="18" cy="24.6" r="2.5" fill={c.dot} stroke={c.dotStroke} stroke-width="1.3"></circle>
</svg>
