---
import { clients } from '../data/home';
---

<div class="clients on-cream">
  <div class="wrap">
    <div class="clients__in">
      <span class="kicker kicker--ink clients__lbl" id="clients-label">{clients.label}</span>
      <ul aria-labelledby="clients-label">
        {clients.names.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </div>
</div>
