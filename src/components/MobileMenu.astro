---
import { mobileNav } from '../data/navigation';
import { siteConfig } from '../config/site';
import { url } from '../utils/url';
import { ariaCurrent } from '../utils/nav';

const path = Astro.url.pathname;
---

<div class="mob" id="mob" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <button class="mob__x" id="mobX" type="button" aria-label="Close menu">&times;</button>
  <nav class="mob__nav" aria-label="Mobile">
    {mobileNav.map((item) => (
      <a href={url(item.href)} aria-current={ariaCurrent(item, path)}>{item.label}</a>
    ))}
  </nav>
  <a href={url(siteConfig.cta.href)} class="btn btn--heat">{siteConfig.cta.label}</a>
</div>
