---
import type { Sector } from '../types';
import { url } from '../utils/url';

interface Props {
  sector: Sector;
  delay?: number;
}

const { sector, delay = 0 } = Astro.props;
---

<article class="sc rv" style={delay ? `--d:${delay}ms` : undefined}>
  <img src={url(sector.image)} alt={sector.imageAlt} width="1000" height="656" loading="lazy" decoding="async" />
  <div class="sc__c">
    <h3 class="d4">{sector.title}</h3>
    <p>{sector.description}</p>
  </div>
</article>
