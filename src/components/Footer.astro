---
import Brand from './Brand.astro';
import Icon from './icons/Icon.astro';
import Newsletter from './Newsletter.astro';
import { siteConfig } from '../config/site';
import { footerColumns, legalLinks } from '../data/navigation';
import { phoneDisplay, url } from '../utils/url';
---

<footer class="ftr">
  <div class="wrap">
    <Newsletter />

    <div class="fgrid">
      <div>
        <Brand variant="footer" />
        <p>{siteConfig.footerBlurb}</p>
        {siteConfig.social.length > 0 && (
          <ul class="soc">
            {siteConfig.social.map((s) => (
              <li>
                <a href={url(s.href)} aria-label={s.label} rel={/^https?:/.test(s.href) ? 'noopener' : undefined}>
                  <Icon name={s.icon} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>

      {footerColumns.map((col) => (
        <nav class="fcol" aria-labelledby={`f-${col.title.toLowerCase()}`}>
          <h2 id={`f-${col.title.toLowerCase()}`}>{col.title}</h2>
          {col.links.map((l) => <a href={url(l.href)}>{l.label}</a>)}
        </nav>
      ))}

      <div class="fcol">
        <h2>Contact</h2>
        <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        <a href={`tel:${siteConfig.phoneHref}`}>{phoneDisplay(siteConfig.phone)}</a>
        <address>{siteConfig.location.lines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</address>
      </div>
    </div>

    <div class="fbot">
      <p>{siteConfig.copyright}</p>
      {legalLinks.length > 0 && (
        <ul class="fleg">
          {legalLinks.map((l) => <li><a href={url(l.href)}>{l.label}</a></li>)}
        </ul>
      )}
    </div>
  </div>
</footer>
