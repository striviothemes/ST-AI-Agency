---
import SectionHeading from './SectionHeading.astro';
import SectorCard from './SectorCard.astro';
import { sectors } from '../data/sectors';
import { sections } from '../data/home';
---

<section class="sec on-white" id="sectors" aria-labelledby="sectors-title">
  <div class="wrap">
    <SectionHeading heading={sections.sectors} id="sectors-title" />
    <div class="sect">
      {sectors.map((sector, i) => <SectorCard sector={sector} delay={i * 70} />)}
    </div>
  </div>
</section>
