---
import SectionHeading from './SectionHeading.astro';
import SolutionRow from './SolutionRow.astro';
import { solutions } from '../data/solutions';
import { sections } from '../data/home';
---

<section class="sec on-cream" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <SectionHeading heading={sections.solutions} id="services-title" />
    <ul class="srv">
      {solutions.map((solution) => <SolutionRow solution={solution} />)}
    </ul>
  </div>
</section>
