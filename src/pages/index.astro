---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ClientStrip from '../components/ClientStrip.astro';
import Solutions from '../components/Solutions.astro';
import Platform from '../components/Platform.astro';
import Process from '../components/Process.astro';
import Customers from '../components/Customers.astro';
import Stats from '../components/Stats.astro';
import Sectors from '../components/Sectors.astro';
import Testimonials from '../components/Testimonials.astro';
import Team from '../components/Team.astro';
import Pricing from '../components/Pricing.astro';
import InsightsPreview from '../components/InsightsPreview.astro';
import FAQ from '../components/FAQ.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { hero } from '../data/home';
import { url } from '../utils/url';
---

<BaseLayout preloadImage={url(hero.image)}>
  <Hero />
  <ClientStrip />
  <Solutions />
  <Platform />
  <Process />
  <Customers />
  <Stats />
  <Sectors />
  <Testimonials />
  <Team />
  <Pricing />
  <InsightsPreview />
  <FAQ />
  <ContactCTA />
  <FinalCTA />
</BaseLayout>
