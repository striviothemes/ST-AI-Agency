---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import { siteConfig } from '../config/site';
import { url } from '../utils/url';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex>
  <PageHero
    class="nf"
    center
    kicker="Error 404 — page not found"
    title="This run ended without a result."
    lead="The page you asked for has moved, been renamed or never existed. Nothing is broken on your side — here are a few good places to pick up again."
  >
    <span slot="before" class="nf__code rv" aria-hidden="true">404</span>
    <div class="btns rv" style="--d:190ms">
      <Button href="/" variant="white">Back to the homepage</Button>
      <Button href={siteConfig.cta.href} variant="ow">{siteConfig.cta.label}</Button>
    </div>
    <nav class="nf__links rv" style="--d:250ms" aria-label="Popular sections">
      <a href={url('/#services')}>Solutions</a>
      <a href={url('/#pricing')}>Pricing</a>
      <a href={url('/#work')}>Customers</a>
      <a href={url('/blog')}>Insights</a>
      <a href={url('/#contact')}>Contact</a>
    </nav>
  </PageHero>
</BaseLayout>
