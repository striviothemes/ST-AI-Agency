---
import { render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPosts, relatedPosts, type BlogPost } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // posts are newest first: "previous" is the older article, "next" the newer one
      prev: posts[i + 1],
      next: posts[i - 1],
      related: relatedPosts(post, posts),
    },
  }));
}

interface Props {
  post: BlogPost;
  prev?: BlogPost;
  next?: BlogPost;
  related: BlogPost[];
}

const { post, prev, next, related } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout post={post} prev={prev} next={next} related={related}>
  <Content />
</BlogPostLayout>
