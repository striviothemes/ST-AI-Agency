---
import '@fontsource-variable/outfit/wght.css';
import '@fontsource-variable/inter-tight/wght.css';
import outfitLatin from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/blog.css';

import SEO, { type SEOProps } from '../components/SEO.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site';

interface Props extends SEOProps {
  /** Image to preload (the hero photograph on the homepage). */
  preloadImage?: string;
}

const { preloadImage, ...seo } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marks JS as available before first paint so reveal / accordion styles only apply with JS. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href={outfitLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <SEO {...seo} />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <MobileMenu />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
